import azure.functions as func
import requests
from datetime import datetime
import xml.etree.ElementTree as ET
from xml.sax.saxutils import escape
import pytz

app = func.FunctionApp(http_auth_level=func.AuthLevel.FUNCTION)


def fetch_cbar_xml():
    baku_tz = pytz.timezone('Asia/Baku')

    date_obj = datetime.now(baku_tz)

    date_str = date_obj.strftime("%d.%m.%Y")

    url = f"https://www.cbar.az/currencies/{date_str}.xml"

    r = requests.get(url, timeout=20)
    r.raise_for_status()

    return r.text, date_obj


def transform_to_bc_xml(cbar_xml: str, fallback_date: datetime) -> str:

    root = ET.fromstring(cbar_xml)

    cbar_date = root.attrib.get(
        "Date",
        fallback_date.strftime("%d.%m.%Y")
    )

    try:
        iso_date = datetime.strptime(
            cbar_date,
            "%d.%m.%Y"
        ).strftime("%Y-%m-%d")

    except Exception:
        iso_date = fallback_date.strftime("%Y-%m-%d")

    out = [
        '<?xml version="1.0" encoding="UTF-8"?>',
        "<ExchangeRates>"
    ]

    for valtype in root.findall("ValType"):

        if valtype.attrib.get("Type") != "Xarici valyutalar":
            continue

        for valute in valtype.findall("Valute"):

            code = (valute.attrib.get("Code") or "").strip()

            nominal_raw = (
                valute.findtext("Nominal") or ""
            ).strip()

            value_raw = (
                valute.findtext("Value") or ""
            ).strip()

            if not code or not value_raw:
                continue

            nominal_num = "".join(
                ch for ch in nominal_raw if ch.isdigit()
            )

            if not nominal_num:
                nominal_num = "1"

            out.append("  <Rate>")
            out.append(f"    <CurrencyCode>{escape(code)}</CurrencyCode>")
            out.append(f"    <StartingDate>{iso_date}</StartingDate>")
            out.append(f"    <ExchangeRateAmount>{nominal_num}</ExchangeRateAmount>")
            out.append(f"    <RelationalExchRateAmount>{escape(value_raw)}</RelationalExchRateAmount>")
            out.append("  </Rate>")

    out.append("</ExchangeRates>")

    return "\n".join(out)


@app.route(route="cbar/latest", methods=["GET"])
def cbar_latest(req: func.HttpRequest) -> func.HttpResponse:

    try:
        cbar_xml, used_date = fetch_cbar_xml()

        bc_xml = transform_to_bc_xml(
            cbar_xml,
            used_date
        )

        return func.HttpResponse(
            bc_xml,
            mimetype="application/xml",
            status_code=200
        )

    except Exception as e:

        return func.HttpResponse(
            f"Error: {str(e)}",
            status_code=500
        )


@app.route(route="cbar/date/{date}", methods=["GET"])
def cbar_by_date(req: func.HttpRequest) -> func.HttpResponse:

    date = req.route_params.get("date")

    try:
        date_obj = datetime.strptime(
            date,
            "%d.%m.%Y"
        )

    except ValueError:

        return func.HttpResponse(
            "Invalid date format. Use DD.MM.YYYY",
            status_code=400
        )

    date_str = date_obj.strftime("%d.%m.%Y")

    url = f"https://www.cbar.az/currencies/{date_str}.xml"

    try:
        r = requests.get(url, timeout=20)

        if r.status_code != 200:

            return func.HttpResponse(
                "CBAR data not available for given date",
                status_code=404
            )

        bc_xml = transform_to_bc_xml(
            r.text,
            date_obj
        )

        return func.HttpResponse(
            bc_xml,
            mimetype="application/xml",
            status_code=200
        )

    except Exception as e:

        return func.HttpResponse(
            f"Error: {str(e)}",
            status_code=500
        )
